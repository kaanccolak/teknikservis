generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Shop {
  id               String            @id @default(cuid())
  userId           String?           @unique
  name             String
  phone            String?
  phoneDigits      String?
  email            String?
  address          String?
  taxOrTcNo        String?
  taxOffice        String?
  website          String?
  logoUrl          String?
  waPhoneNumberId  String?
  waAccessToken    String?
  waEnabled        Boolean           @default(false)
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  customers        Customer[]
  cariler          Cari[]
  bayiler          Bayi[]
  orders           ServiceOrder[]
  deviceTypes      DeviceType[]
  brands           Brand[]
  models           DeviceModel[]
  spareParts       SparePart[]
  sparePartUsages  SparePartUsage[]
  settings         Setting[]
  externalServices ExternalService[]
  paymentPlans     PaymentPlan[]
  secondHandDevices SecondHandDevice[]
  whatsAppMessages WhatsAppMessage[]
}

model WhatsAppMessage {
  id             String        @id @default(cuid())
  shopId         String?
  shop           Shop?         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  from           String
  message        String
  timestamp      DateTime
  customerName   String?
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([shopId])
  @@index([shopId, isRead])
  @@index([serviceOrderId])
}

model PaymentPlan {
  id           String    @id @default(cuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id])
  title        String
  amount       Float?
  dueDate      DateTime
  isRecurring  Boolean   @default(false)
  recurringDay Int?
  category     String?
  notes        String?
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([shopId])
}

model ExternalService {
  id            String         @id @default(cuid())
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id])
  name          String
  contactName   String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  serviceOrders ServiceOrder[]

  @@index([shopId])
}

model Customer {
  id        String         @id @default(cuid())
  shopId    String
  shop      Shop           @relation(fields: [shopId], references: [id])
  name      String
  phone     String? @db.VarChar(20)
  phoneDigits String? @db.VarChar(20)
  createdAt DateTime       @default(now())
  orders    ServiceOrder[]
}

model DeviceType {
  id         String      @id @default(cuid())
  shopId     String
  shop       Shop        @relation(fields: [shopId], references: [id])
  name       String
  brands     Brand[]
  createdAt  DateTime    @default(now())
  orders     ServiceOrder[]
  spareParts SparePart[]
  secondHandDevices SecondHandDevice[]
}

model Brand {
  id           String        @id @default(cuid())
  shopId       String
  shop         Shop          @relation(fields: [shopId], references: [id])
  deviceTypeId String
  deviceType   DeviceType    @relation(fields: [deviceTypeId], references: [id])
  name         String
  models       DeviceModel[]
  createdAt    DateTime      @default(now())
  orders       ServiceOrder[]
  spareParts   SparePart[]
  secondHandDevices SecondHandDevice[]
}

model DeviceModel {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  name       String
  createdAt  DateTime @default(now())
  orders     ServiceOrder[]
  spareParts SparePart[]
  secondHandDevices SecondHandDevice[]
}

model SecondHandDevice {
  id                String       @id @default(cuid())
  shopId            String
  shop              Shop         @relation(fields: [shopId], references: [id])
  deviceCode        String       @unique

  sellerName        String
  sellerPhone       String?
  sellerPhoneDigits String?
  sellerTcNo        String?

  deviceTypeId      String?
  brandId           String?
  deviceModelId     String?
  deviceType        DeviceType?  @relation(fields: [deviceTypeId], references: [id])
  brand             Brand?       @relation(fields: [brandId], references: [id])
  deviceModel       DeviceModel? @relation(fields: [deviceModelId], references: [id])
  serialNo          String?
  noSerialNo        Boolean      @default(false)

  hasInvoice        Boolean      @default(false)
  hasWarranty       Boolean      @default(false)
  hasBox            Boolean      @default(false)

  purchasePrice     Float        @default(0)

  notes             String?

  isSold            Boolean      @default(false)
  soldAt            DateTime?
  soldPrice         Float?
  buyerName         String?
  buyerPhone        String?
  buyerPhoneDigits  String?
  buyerTcNo         String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([shopId])
}

model ServiceOrder {
  id          String   @id @default(cuid())
  /// YYYYMM001; eski satırlar null olabilir (tamamlanınca NOT NULL’a çekilebilir).
  orderNumber String?  @unique
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  cariId     String?
  cari       Cari?    @relation(fields: [cariId], references: [id])
  bayiId     String?
  bayi       Bayi?    @relation(fields: [bayiId], references: [id])

  deviceTypeId   String?
  brandId        String?
  deviceModelId  String?
  deviceType  DeviceType?  @relation(fields: [deviceTypeId], references: [id])
  brand       Brand?       @relation(fields: [brandId], references: [id])
  deviceModel DeviceModel? @relation(fields: [deviceModelId], references: [id])

  deviceTypeName String?
  brandName      String?
  modelName      String?

  serialNo   String?
  noSerialNo Boolean @default(false)

  /// guaranteed | no_warranty
  warrantyStatus String?
  isTampered     Boolean @default(false)

  complaint      String?
  accessories    String?
  physicalDamage String?

  technicianNote String?
  totalPrice     Float?
  estimatedPrice Float?

  /// Uygulama durumları: in_service, returned_device, waiting_approval, approval_given, waiting_part, sent_to_external, repair_failed, … (eski kayıtlarda başka anahtarlar olabilir).
  status String @default("in_service")

  arrivedByCargo Boolean  @default(false)
  cargoInfo      String?
  arrivedAt      DateTime @default(now())
  trackingCode   String?

  externalServiceId String?
  externalService   ExternalService? @relation(fields: [externalServiceId], references: [id])
  externalNote      String?
  repairFailedReason String?

  /// Teslim: self | other
  deliveryType       String?
  deliveryPersonName String?
  deliveryNote       String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  statusLogs       StatusLog[]
  sparePartUsages  SparePartUsage[]
  whatsAppMessages WhatsAppMessage[]
}

model Bayi {
  id            String         @id @default(cuid())
  shopId         String
  shop           Shop           @relation(fields: [shopId], references: [id])
  bayiCode       String         @unique
  firmaAdi       String
  yetkiliKisi    String
  phone          String
  phoneDigits    String
  vergiDairesi   String?
  tcVergiNo      String
  /// Bayi iskonto grubu: grup1 (%10), grup2 (%20), null = grup yok
  grup           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  serviceOrders  ServiceOrder[]
}

model Cari {
  id            String         @id @default(cuid())
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id])
  cariCode      String?        @unique
  name          String
  phone         String?
  phoneDigits   String?
  email         String?
  address       String?
  taxOrTcNo     String?
  taxOffice     String?
  cargoInfo     String?
  cargoCode     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  serviceOrders ServiceOrder[]
}

model Setting {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, key])
}

model StatusLog {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  oldStatus      String?
  newStatus      String
  note           String?
  createdAt      DateTime     @default(now())
}

model SparePart {
  id             String       @id @default(cuid())
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id])
  name           String
  partCode       String?
  cost           Float        @default(0)
  stock          Int          @default(0)
  deviceTypeId   String?
  brandId        String?
  deviceModelId  String?
  deviceType     DeviceType?  @relation(fields: [deviceTypeId], references: [id])
  brand          Brand?       @relation(fields: [brandId], references: [id])
  deviceModel    DeviceModel? @relation(fields: [deviceModelId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  usages         SparePartUsage[]
}

model SparePartUsage {
  id             String       @id @default(cuid())
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id])
  sparePartId    String
  sparePart      SparePart    @relation(fields: [sparePartId], references: [id])
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  quantity       Int          @default(1)
  costAtTime     Float        @default(0)
  createdAt      DateTime     @default(now())
}
