generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Shop {
  id               String            @id @default(cuid())
  name             String
  createdAt        DateTime          @default(now())
  customers        Customer[]
  cariler          Cari[]
  orders           ServiceOrder[]
  deviceTypes      DeviceType[]
  brands           Brand[]
  models           DeviceModel[]
  spareParts       SparePart[]
  sparePartUsages  SparePartUsage[]
  settings         Setting[]
}

model Customer {
  id        String         @id @default(cuid())
  shopId    String
  shop      Shop           @relation(fields: [shopId], references: [id])
  name      String
  phone     String? @db.VarChar(20)
  phoneDigits String? @db.VarChar(20)
  createdAt DateTime       @default(now())
  orders    ServiceOrder[]
}

model DeviceType {
  id         String      @id @default(cuid())
  shopId     String
  shop       Shop        @relation(fields: [shopId], references: [id])
  name       String
  brands     Brand[]
  createdAt  DateTime    @default(now())
  orders     ServiceOrder[]
  spareParts SparePart[]
}

model Brand {
  id           String        @id @default(cuid())
  shopId       String
  shop         Shop          @relation(fields: [shopId], references: [id])
  deviceTypeId String
  deviceType   DeviceType    @relation(fields: [deviceTypeId], references: [id])
  name         String
  models       DeviceModel[]
  createdAt    DateTime      @default(now())
  orders       ServiceOrder[]
  spareParts   SparePart[]
}

model DeviceModel {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  name       String
  createdAt  DateTime @default(now())
  orders     ServiceOrder[]
  spareParts SparePart[]
}

model ServiceOrder {
  id          String   @id @default(cuid())
  /// YYYYMM001; eski satırlar null olabilir (tamamlanınca NOT NULL’a çekilebilir).
  orderNumber String?  @unique
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  cariId     String?
  cari       Cari?    @relation(fields: [cariId], references: [id])

  deviceTypeId   String?
  brandId        String?
  deviceModelId  String?
  deviceType  DeviceType?  @relation(fields: [deviceTypeId], references: [id])
  brand       Brand?       @relation(fields: [brandId], references: [id])
  deviceModel DeviceModel? @relation(fields: [deviceModelId], references: [id])

  deviceTypeName String?
  brandName      String?
  modelName      String?

  serialNo   String?
  noSerialNo Boolean @default(false)

  /// guaranteed | no_warranty
  warrantyStatus String?
  isTampered     Boolean @default(false)

  complaint      String?
  accessories    String?
  physicalDamage String?

  technicianNote String?
  totalPrice     Float?

  /// Uygulama durumları: in_service, waiting_approval, approval_given, waiting_part, completed, delivered (eski kayıtlarda başka anahtarlar olabilir).
  status String @default("in_service")

  arrivedByCargo Boolean  @default(false)
  cargoInfo      String?
  arrivedAt      DateTime @default(now())
  trackingCode   String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  statusLogs       StatusLog[]
  sparePartUsages  SparePartUsage[]
}

model Cari {
  id            String         @id @default(cuid())
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id])
  cariCode      String?        @unique
  name          String
  phone         String?
  phoneDigits   String?
  email         String?
  address       String?
  taxOrTcNo     String?
  taxOffice     String?
  cargoInfo     String?
  cargoCode     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  serviceOrders ServiceOrder[]
}

model Setting {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, key])
}

model StatusLog {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  oldStatus      String?
  newStatus      String
  note           String?
  createdAt      DateTime     @default(now())
}

model SparePart {
  id             String       @id @default(cuid())
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id])
  name           String
  partCode       String?
  cost           Float        @default(0)
  stock          Int          @default(0)
  deviceTypeId   String?
  brandId        String?
  deviceModelId  String?
  deviceType     DeviceType?  @relation(fields: [deviceTypeId], references: [id])
  brand          Brand?       @relation(fields: [brandId], references: [id])
  deviceModel    DeviceModel? @relation(fields: [deviceModelId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  usages         SparePartUsage[]
}

model SparePartUsage {
  id             String       @id @default(cuid())
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id])
  sparePartId    String
  sparePart      SparePart    @relation(fields: [sparePartId], references: [id])
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  quantity       Int          @default(1)
  costAtTime     Float        @default(0)
  createdAt      DateTime     @default(now())
}
