# Google Contacts (OAuth) — People API
# Google Cloud Console: OAuth 2.0 Client (Web), People API etkin, Authorized redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
#   ve geliştirmede: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Üretim: https://your-domain.vercel.app — callback ile birebir aynı kök URL kullanın
NEXT_PUBLIC_APP_URL=http://localhost:3000
